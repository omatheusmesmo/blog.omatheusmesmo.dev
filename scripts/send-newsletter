#!/usr/bin/env -S java --source 25

import java.io.IOException;
import java.net.URI;
import java.net.http.HttpClient;
import java.net.http.HttpRequest;
import java.net.http.HttpResponse;
import java.nio.file.Files;
import java.nio.file.Path;
import java.util.regex.Matcher;
import java.util.regex.Pattern;

public class SendNewsletter {

    private static final String BLOG_URL = "https://blog.omatheusmesmo.dev/en/posts";
    private static final String MAILERLITE_API = "https://connect.mailerlite.com/api";
    private static final String GROUP_ID = "190886334920918500";
    private static final String YOUTUBE_RSS = "https://www.youtube.com/feeds/videos.xml?channel_id=UC-agksQ5-WT4l-fnbczYxeA";

    public static void main(String[] args) throws Exception {
        String apiKey = System.getenv("MAILERLITE_API_KEY");
        String testEmail = System.getenv("TEST_EMAIL");
        boolean youtubeMode = java.util.List.of(args).contains("--youtube");

        if (apiKey == null || apiKey.isBlank()) {
            System.err.println("MAILERLITE_API_KEY not set");
            System.exit(1);
        }

        if (youtubeMode) {
            handleYoutube(apiKey, testEmail);
        } else {
            handleBlog(apiKey, testEmail);
        }
    }

    private static void handleBlog(String apiKey, String testEmail) throws Exception {
        String postDir = detectNewPost();
        if (postDir == null) {
            System.out.println("No new post detected");
            return;
        }

        System.out.println("New post detected: " + postDir);

        Path frontmatter = Path.of("content/posts/" + postDir + "/index.en.md");
        if (!Files.exists(frontmatter)) {
            System.err.println("No index.en.md found for " + postDir);
            System.exit(1);
        }

        String content = Files.readString(frontmatter);
        String title = extractField(content, "title");
        String description = extractField(content, "description");
        String slug = extractField(content, "slug");

        if (title == null || description == null || slug == null) {
            System.err.println("Missing required frontmatter fields");
            System.exit(1);
        }

        String articleUrl = BLOG_URL + "/" + slug + "/";
        String html = buildBlogEmailHtml(title, description, articleUrl);

        if (testEmail != null && !testEmail.isBlank()) {
            createDraft(apiKey, testEmail, title, html);
        } else {
            sendToGroup(apiKey, title, html);
        }
    }

    private static void handleYoutube(String apiKey, String testEmail) throws Exception {
        String videoId = detectNewVideo();
        if (videoId == null) {
            System.out.println("No new video detected");
            return;
        }

        String videoUrl = "https://www.youtube.com/watch?v=" + videoId;

        if (isVideoAlreadySent(videoUrl)) {
            System.out.println("Video already sent: " + videoId);
            return;
        }

        System.out.println("New video detected: " + videoId);

        String[] videoInfo = fetchVideoInfo(videoId);
        String title = videoInfo[0];
        String description = videoInfo[1];
        String thumbnailUrl = "https://i1.ytimg.com/vi/" + videoId + "/hqdefault.jpg";

        String html = buildYoutubeEmailHtml(title, description, videoUrl, thumbnailUrl);

        if (testEmail != null && !testEmail.isBlank()) {
            createDraft(apiKey, testEmail, "New Video: " + title, html);
        } else {
            sendToGroup(apiKey, "New Video: " + title, html);
        }
    }

    private static boolean isVideoAlreadySent(String videoUrl) throws Exception {
        String readmePath = System.getenv().getOrDefault("README_PATH", "profile-repo/README.md");
        Path path = Path.of(readmePath);
        if (!Files.exists(path)) return false;

        String content = Files.readString(path);
        return content.contains(videoUrl);
    }

    private static String detectNewPost() throws Exception {
        String envDir = System.getenv("ARTICLE_DIR");
        if (envDir != null && !envDir.isBlank()) {
            return envDir.trim();
        }

        var pb = new ProcessBuilder("git", "diff", "HEAD~1", "--name-only", "--", "content/posts/");
        pb.redirectErrorStream(true);
        var proc = pb.start();
        String output = new String(proc.getInputStream().readAllBytes()).trim();
        proc.waitFor();

        if (!output.isEmpty()) {
            String firstLine = output.lines().findFirst().orElse(null);
            if (firstLine != null) {
                String[] parts = firstLine.split("/");
                if (parts.length >= 3) {
                    return parts[1];
                }
            }
        }

        return latestPostDir();
    }

    private static String latestPostDir() throws Exception {
        Path posts = Path.of("content/posts");
        if (!Files.isDirectory(posts)) return null;
        try (var stream = Files.list(posts)) {
            return stream
                .filter(Files::isDirectory)
                .map(p -> p.getFileName().toString())
                .sorted(java.util.Comparator.reverseOrder())
                .findFirst()
                .orElse(null);
        }
    }

    private static String detectNewVideo() throws Exception {
        String envVideoId = System.getenv("VIDEO_ID");
        if (envVideoId != null && !envVideoId.isBlank()) {
            return envVideoId.trim();
        }

        HttpClient client = HttpClient.newHttpClient();
        HttpRequest request = HttpRequest.newBuilder()
            .uri(URI.create(YOUTUBE_RSS))
            .GET()
            .build();

        HttpResponse<String> response = client.send(request, HttpResponse.BodyHandlers.ofString());
        String xml = response.body();

        Pattern videoIdPattern = Pattern.compile("<yt:videoId>(.*?)</yt:videoId>");
        Matcher matcher = videoIdPattern.matcher(xml);
        if (matcher.find()) {
            return matcher.group(1);
        }
        return null;
    }

    private static String[] fetchVideoInfo(String videoId) throws Exception {
        HttpClient client = HttpClient.newHttpClient();
        HttpRequest request = HttpRequest.newBuilder()
            .uri(URI.create(YOUTUBE_RSS))
            .GET()
            .build();

        HttpResponse<String> response = client.send(request, HttpResponse.BodyHandlers.ofString());
        String xml = response.body();

        String entryPattern = "<yt:videoId>" + Pattern.quote(videoId) + "</yt:videoId>";
        int idx = xml.indexOf("<yt:videoId>" + videoId + "</yt:videoId>");
        if (idx < 0) return new String[]{"Unknown", ""};

        int entryStart = xml.lastIndexOf("<entry>", idx);
        int entryEnd = xml.indexOf("</entry>", idx);
        if (entryStart < 0 || entryEnd < 0) return new String[]{"Unknown", ""};

        String entry = xml.substring(entryStart, entryEnd);

        Pattern titlePattern = Pattern.compile("<title>(.*?)</title>");
        Pattern descPattern = Pattern.compile("<media:description>(.*?)</media:description>", Pattern.DOTALL);

        String title = "Unknown";
        String description = "";

        Matcher titleMatcher = titlePattern.matcher(entry);
        if (titleMatcher.find()) {
            title = titleMatcher.group(1)
                .replace("&amp;", "&")
                .replace("&#39;", "'")
                .replace("&quot;", "\"");
        }

        Matcher descMatcher = descPattern.matcher(entry);
        if (descMatcher.find()) {
            description = descMatcher.group(1)
                .replace("&amp;", "&")
                .replace("&#39;", "'")
                .replace("&quot;", "\"")
                .trim();
            if (description.length() > 200) {
                description = description.substring(0, 200).replaceAll("\\s+\\S*$", "") + "...";
            }
        }

        return new String[]{title, description};
    }

    private static String extractField(String content, String field) {
        Pattern pattern = Pattern.compile("^" + field + ":\\s*\"(.+?)\"", Pattern.MULTILINE);
        Matcher matcher = pattern.matcher(content);
        if (matcher.find()) {
            return matcher.group(1);
        }

        pattern = Pattern.compile("^" + field + ":\\s*(.+)$", Pattern.MULTILINE);
        matcher = pattern.matcher(content);
        if (matcher.find()) {
            return matcher.group(1).trim();
        }
        return null;
    }

    private static String buildBlogEmailHtml(String title, String description, String url) {
        StringBuilder sb = new StringBuilder();
        sb.append("<!DOCTYPE html><html><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\"></head>");
        sb.append("<body style=\"margin:0;padding:0;background-color:#FAF8F5;font-family:'Segoe UI','Helvetica Neue',Helvetica,Arial,sans-serif;\">");
        sb.append("<table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" width=\"100%\" style=\"background-color:#FAF8F5;\">");
        sb.append("<tr><td align=\"center\" style=\"padding:40px 20px;\">");
        sb.append("<table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" width=\"100%\" style=\"max-width:580px;\">");
        sb.append("<tr><td>");

        sb.append("<table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" width=\"100%\" style=\"background-color:#FFFFFF;border-radius:16px;overflow:hidden;box-shadow:0 1px 3px rgba(44,36,23,0.04),0 8px 24px rgba(44,36,23,0.07);\">");

        sb.append("<tr><td style=\"background:linear-gradient(135deg,#B07219 0%,#8C5A14 100%);padding:40px 32px 32px;text-align:left;\">");
        sb.append("<p style=\"margin:0 0 16px;display:inline-block;background:rgba(255,255,255,0.18);color:#FFFFFF;font-size:11px;font-weight:600;text-transform:uppercase;letter-spacing:1.5px;padding:5px 12px;border-radius:20px;\">New Article</p>");
        sb.append("<h1 style=\"margin:0 0 8px;color:#FFFFFF;font-size:28px;font-weight:800;line-height:1.2;letter-spacing:-0.5px;\">").append(escapeHtml(title)).append("</h1>");
        sb.append("<p style=\"margin:0;color:rgba(255,255,255,0.75);font-size:14px;line-height:1.5;max-width:380px;\">").append(truncate(escapeHtml(description), 120)).append("</p>");
        sb.append("</td></tr>");

        sb.append("<tr><td style=\"padding:36px 32px;\">");

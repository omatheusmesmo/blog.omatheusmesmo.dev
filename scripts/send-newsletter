        sb.append("<p style=\"margin:0 0 28px;color:#6B5D4F;font-size:14px;line-height:1.8;\">").append(escapeHtml(description)).append("</p>");

        sb.append("<table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" width=\"100%\"><tr><td align=\"center\">");
        sb.append("<a href=\"").append(url).append("\" style=\"display:inline-block;background:linear-gradient(135deg,#B07219,#8C5A14);color:#FFFFFF;text-decoration:none;padding:16px 36px;border-radius:10px;font-weight:700;font-size:15px;box-shadow:0 4px 14px rgba(176,114,25,0.25);\">Read the Article &rarr;</a>");
        sb.append("</td></tr></table>");
        sb.append("</td></tr>");

        sb.append("<tr><td style=\"padding:0 32px;\"><table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" width=\"100%\"><tr><td style=\"border-top:1px solid #EDE8E1;\"></td></tr></table></td></tr>");

        sb.append("<tr><td style=\"background:#FAF8F5;padding:28px 32px;border-top:1px solid #EDE8E1;\">");
        sb.append("<p style=\"margin:0 0 4px;color:#9C8E7E;font-size:12px;\">Best regards,</p>");
        sb.append("<p style=\"margin:0 0 20px;color:#2C2417;font-size:15px;font-weight:700;\">Matheus Oliveira</p>");
        sb.append("<a href=\"https://blog.omatheusmesmo.dev\" style=\"color:#B07219;text-decoration:none;font-size:12px;font-weight:500;\">Blog</a> ");
        sb.append("<span style=\"color:#D6CFC5;margin:0 8px;\">·</span> ");
        sb.append("<a href=\"https://github.com/omatheusmesmo\" style=\"color:#B07219;text-decoration:none;font-size:12px;font-weight:500;\">GitHub</a> ");
        sb.append("<span style=\"color:#D6CFC5;margin:0 8px;\">·</span> ");
        sb.append("<a href=\"https://linkedin.com/in/omatheusmesmo\" style=\"color:#B07219;text-decoration:none;font-size:12px;font-weight:500;\">LinkedIn</a>");
        sb.append("<p style=\"margin:20px 0 0;color:#9C8E7E;font-size:11px;\">");
        sb.append("<a href=\"{$unsubscribe}\" style=\"color:#B07219;text-decoration:underline;\">Unsubscribe</a>");
        sb.append(" · <a href=\"{$url}\" style=\"color:#B07219;text-decoration:underline;\">View in browser</a>");
        sb.append("</p></td></tr>");

        sb.append("</table></td></tr></table></td></tr></table></body></html>");
        return sb.toString();
    }

    private static String buildYoutubeEmailHtml(String title, String description, String videoUrl, String thumbnailUrl) {
        StringBuilder sb = new StringBuilder();
        sb.append("<!DOCTYPE html><html><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\"></head>");
        sb.append("<body style=\"margin:0;padding:0;background-color:#FAF8F5;font-family:'Segoe UI','Helvetica Neue',Helvetica,Arial,sans-serif;\">");
        sb.append("<table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" width=\"100%\" style=\"background-color:#FAF8F5;\">");
        sb.append("<tr><td align=\"center\" style=\"padding:40px 20px;\">");
        sb.append("<table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" width=\"100%\" style=\"max-width:580px;\">");
        sb.append("<tr><td>");

        sb.append("<table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" width=\"100%\" style=\"background-color:#FFFFFF;border-radius:16px;overflow:hidden;box-shadow:0 1px 3px rgba(44,36,23,0.04),0 8px 24px rgba(44,36,23,0.07);\">");

        sb.append("<tr><td style=\"background:linear-gradient(135deg,#B07219 0%,#8C5A14 100%);padding:40px 32px 32px;text-align:left;\">");
        sb.append("<p style=\"margin:0 0 16px;display:inline-block;background:rgba(255,255,255,0.18);color:#FFFFFF;font-size:11px;font-weight:600;text-transform:uppercase;letter-spacing:1.5px;padding:5px 12px;border-radius:20px;\">New Video</p>");
        sb.append("<h1 style=\"margin:0 0 8px;color:#FFFFFF;font-size:28px;font-weight:800;line-height:1.2;letter-spacing:-0.5px;\">").append(escapeHtml(title)).append("</h1>");

    private static String escapeHtml(String text) {
        if (text == null) return "";
        return text.replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;").replace("\"", "&quot;");
    }

    private static String truncate(String text, int maxLen) {
        if (text == null || text.length() <= maxLen) return text;
        return text.substring(0, maxLen).replaceAll("\\s+\\S*$", "") + "...";
    }

    private static void sendToGroup(String apiKey, String subject, String html) throws Exception {
        String campaignId = createCampaign(apiKey, subject, html, GROUP_ID);
        scheduleCampaign(apiKey, campaignId);
    }

    private static void createDraft(String apiKey, String testEmail, String subject, String html) throws Exception {
        String testGroupId = createTestGroup(apiKey, testEmail);
        String campaignId = createCampaign(apiKey, subject, html, testGroupId);
        scheduleCampaign(apiKey, campaignId);
        System.out.println("Test email sent to " + testEmail);
    }

    private static String createTestGroup(String apiKey, String email) throws Exception {
        HttpClient client = HttpClient.newHttpClient();

        String body = "{\"name\":\"Newsletter Test\"}";
        HttpRequest request = HttpRequest.newBuilder()
            .uri(URI.create(MAILERLITE_API + "/groups"))
            .header("Authorization", "Bearer " + apiKey)
            .header("Content-Type", "application/json")
            .POST(HttpRequest.BodyPublishers.ofString(body))
            .build();

        HttpResponse<String> response = client.send(request, HttpResponse.BodyHandlers.ofString());
        String groupId = extractJsonField(response.body(), "id");
        if (groupId == null) {
            System.err.println("Could not create test group: " + response.body());
            System.exit(1);
        }
        System.out.println("Test group created: " + groupId);

        String subBody = "{\"email\":\"" + escapeJson(email) + "\",\"groups\":[\"" + groupId + "\"]}";
        HttpRequest subRequest = HttpRequest.newBuilder()
            .uri(URI.create(MAILERLITE_API + "/subscribers"))
            .header("Authorization", "Bearer " + apiKey)
            .header("Content-Type", "application/json")
            .POST(HttpRequest.BodyPublishers.ofString(subBody))
            .build();

        HttpResponse<String> subResponse = client.send(subRequest, HttpResponse.BodyHandlers.ofString());
        System.out.println("Subscriber added: " + subResponse.statusCode());

        return groupId;
    }

    private static String createCampaign(String apiKey, String subject, String html, String groupId) throws Exception {
        HttpClient client = HttpClient.newHttpClient();

        String body = "{\"name\":\"Newsletter: " + escapeJson(subject) + "\","
                + "\"type\":\"regular\","
                + "\"emails\":[{\"subject\":\"" + escapeJson(subject)
                + "\",\"from_name\":\"Matheus Oliveira\",\"from\":\"hi@omatheusmesmo.dev\""
                + ",\"content\":\"" + escapeJson(html) + "\"}],"
                + "\"groups\":[\"" + groupId + "\"]}";

        HttpRequest request = HttpRequest.newBuilder()
            .uri(URI.create(MAILERLITE_API + "/campaigns"))
            .header("Authorization", "Bearer " + apiKey)
            .header("Content-Type", "application/json")
            .POST(HttpRequest.BodyPublishers.ofString(body))
            .build();

        HttpResponse<String> response = client.send(request, HttpResponse.BodyHandlers.ofString());
        System.out.println("Campaign created: " + response.statusCode());

        if (response.statusCode() >= 400) {
            System.err.println(response.body());
            System.exit(1);
        }

        String id = extractJsonField(response.body(), "id");
        if (id == null) {
            System.err.println("Could not extract campaign ID from response");
            System.err.println(response.body());
            System.exit(1);
        }
        return id;
    }

    private static void scheduleCampaign(String apiKey, String campaignId) throws Exception {
        HttpClient client = HttpClient.newHttpClient();

        String body = "{\"delivery\":\"instant\"}";

        HttpRequest request = HttpRequest.newBuilder()
            .uri(URI.create(MAILERLITE_API + "/campaigns/" + campaignId + "/schedule"))
            .header("Authorization", "Bearer " + apiKey)
            .header("Content-Type", "application/json")
            .POST(HttpRequest.BodyPublishers.ofString(body))
            .build();

        HttpResponse<String> response = client.send(request, HttpResponse.BodyHandlers.ofString());
        System.out.println("Campaign scheduled: " + response.statusCode());
        System.out.println(response.body());
    }

    private static String extractJsonField(String json, String field) {
        Pattern p = Pattern.compile("\"" + field + "\"\\s*:\\s*\"?(\\d+)\"?");
        Matcher m = p.matcher(json);
        return m.find() ? m.group(1) : null;
    }

    private static String escapeJson(String text) {
        if (text == null) return "";
        return text.replace("\\", "\\\\").replace("\"", "\\\"").replace("\n", "\\n").replace("\r", "");
    }
}
